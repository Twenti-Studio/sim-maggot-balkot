APP_NAME="SIM Rumah Maggot Balkot"
APP_ENV=production
APP_KEY=
INITIAL_ADMIN_PASSWORD=change-with-a-strong-password
APP_DEBUG=false
APP_URL=https://simaggotbalkot.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sim_maggot_balkot
DB_USERNAME=maggot_app
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.simaggotbalkot.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@simaggotbalkot.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:admin@simaggotbalkot.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
